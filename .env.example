# --- Solari (agent compute) ---------------------------------------------------
# Required. Your Solari API key (slr_live_...), from https://console.getsolari.com
SOLARI_API_KEY=

# Solari HTTP gateway. Change only for staging / self-hosted; a non-default value
# also overrides the browser SDK's region routing.
SOLARI_BASE_URL=https://api.getsolari.com

# Browser SDK region.
SOLARI_REGION=us-west

# Per-RPC timeout (ms) for sandbox/desktop control channels.
SOLARI_CALL_TIMEOUT_MS=30000

# How long launch_* waits for a machine to become usable (seconds).
SOLARI_LAUNCH_TIMEOUT_S=120

# --- LLM providers ----------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Bench control plane (later modules) -----------------------------------
BENCH_MAX_WORKERS=10
BENCH_TASK_BUDGET_USD=
BENCH_RETRY_LIMIT=2
BENCH_QUARANTINE=true

# --- Policy engine (module 2) --------------------------------------------
# Effect applied when no rule matches. DENY (allowlist, recommended) or AUDIT
# (permissive: allow but flag). Never ALLOW.
POLICY_DEFAULT_EFFECT=DENY
# Extra rule files/dirs, loaded after the bundled defaults (os path separator).
POLICY_RULES_PATH=
# Set true to skip the rule set bundled with bench.policy.
POLICY_DISABLE_DEFAULTS=false

# --- Audit trail (module 3) -------------------------------------------
# Storage backend: jsonl (append-only file) or memory (non-persistent).
BENCH_AUDIT_BACKEND=jsonl
# Path to the JSONL log when backend=jsonl.
BENCH_AUDIT_PATH=.bench/audit.jsonl
